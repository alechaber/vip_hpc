# config.env: every script sources this file. Change values here, nowhere else.
# Optional but handy: all versions, paths and job sizes sit at the top in one place.

# Project root (the folder that holds config/, lib/ and scripts/)
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Sample and versions
export SAMPLE=SRR622461
export SUBSAMPLE_READS=5000000            # read pairs kept from the SRA archive
export GATK_MODULE_VERSION=4.6.2.0
export GATK_VERSION=4.7.0.0
export PB_VERSION=4.5.1
export BIO_MODULE=bioinformatics/20260810 # bwa, samtools, bcftools, SRA tools
export GATK_MODULE=gatk/${GATK_MODULE_VERSION}

# Slurm
export ACCOUNT=torch_pr_473_general
export SBATCH_ACCOUNT=${ACCOUNT}          # Slurm reads this, so no --account flag per job
export GPU_PARTITION=l40s_public

# Directories
export WORK=/scratch/${USER}/vip_a1
export REF_DIR=/scratch/${USER}/hg38
export FASTQ_DIR=${WORK}/fastq
export REF_DATA_DIR=${WORK}/ref
export BAM_DIR=${WORK}/bam
export VCF_DIR=${WORK}/vcf
export SWEEP_DIR=${WORK}/sweep
export LOG_DIR=${WORK}/logs
export SBATCH_DIR=${WORK}/sbatch          # generated job scripts land here
export CACHE_DIR=${WORK}/.apptainer_cache

# Reference files
export REF=${REF_DIR}/Homo_sapiens.GRCh38.dna_sm.primary_assembly.normalized.fa
export KNOWN_SITES=${REF_DATA_DIR}/homo_sapiens-chr1.vcf.gz   # Ensembl contig names (1..22, X, Y, MT)
export INTERVALS=1                        # reads sit on chr1; confirm with ${SAMPLE}_idxstats.txt

# Containers. Apptainer pulls the Docker image on first use, so there is no separate pull step.
export GATK_IMAGE=docker://broadinstitute/gatk:${GATK_VERSION}
export PB_SIF=/share/apps/images/parabricks-${PB_VERSION}.sif

# Per-sample file names (the sample name is in every output, so many samples never collide)
export FASTQ_1=${FASTQ_DIR}/${SAMPLE}_1.fastq.gz
export FASTQ_2=${FASTQ_DIR}/${SAMPLE}_2.fastq.gz
export SORTED_BAM=${BAM_DIR}/${SAMPLE}_sorted.bam
export DEDUP_BAM=${BAM_DIR}/${SAMPLE}_dedup.bam
export DUP_METRICS=${BAM_DIR}/${SAMPLE}_dup_metrics.txt
export IDXSTATS=${BAM_DIR}/${SAMPLE}_idxstats.txt
export RECAL_TABLE=${BAM_DIR}/${SAMPLE}_recal.table
export READ_GROUP="@RG\tID:${SAMPLE}\tSM:${SAMPLE}\tPL:ILLUMINA\tLB:lib1"

# Job sizes. Sized from the first run's seff results; raise them for bigger samples.
# Use 2 CPUs where 1 would do (Slurm hands out CPUs in pairs).
# Short walltimes start sooner than the 1-hour default.
export DOWNLOAD_CPUS=4  DOWNLOAD_MEM=4G   DOWNLOAD_TIME=00:30:00
export PREP_CPUS=8      PREP_MEM=28G      PREP_TIME=00:20:00     # peaked near 24 GB of the old 32 GB
export BQSR_CPUS=2      BQSR_MEM=8G       BQSR_TIME=00:20:00
export APPLYBQSR_CPUS=2 APPLYBQSR_MEM=8G  APPLYBQSR_TIME=00:10:00
export HAPLOTYPECALLER_CPUS=4 HAPLOTYPECALLER_MEM=8G HAPLOTYPECALLER_TIME=00:30:00
export PB_CPUS=8        PB_MEM=48G        PB_TIME=00:20:00
export SWEEP_TIME=00:30:00
