// nextflow.config: parameters, resources and containers. main.nf holds only the logic.

params {
    samplesheet = 'samplesheet.csv'      // columns: sample,bam,recal_table
    ref_fasta   = '/scratch/ah3787/hg38/Homo_sapiens.GRCh38.dna_sm.primary_assembly.normalized.fa'
    ref_dict    = '/scratch/ah3787/hg38/Homo_sapiens.GRCh38.dna_sm.primary_assembly.normalized.dict'
    outdir      = 'results'

    gatk_version     = '4.7.0.0'
    samtools_version = '1.20'
}

process {
    executor = 'slurm'

    withName: 'INDEX_BAM' {
        cpus      = 2
        memory    = '2 GB'
        time      = '10m'
        container = "quay.io/biocontainers/samtools:${params.samtools_version}--h50ea8bc_0"
    }

    withName: 'APPLY_BQSR' {
        cpus      = 2
        memory    = '6 GB'
        time      = '10m'
        container = "broadinstitute/gatk:${params.gatk_version}"
    }

    withName: 'HAPLOTYPECALLER' {
        cpus      = 4
        memory    = '8 GB'
        time      = '20m'
        container = "broadinstitute/gatk:${params.gatk_version}"
    }
}

apptainer.enabled = true
